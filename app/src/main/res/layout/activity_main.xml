<?xml version="1.0" encoding="utf-8"?>
<!-- Root ScrollView lets the single screen remain usable on small devices. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.MainActivity">

    <!-- Vertical LinearLayout stacks every lab control on one screen. -->
    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Username input stores only non-sensitive preference data. -->
        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Username"
            android:inputType="textPersonName"
            android:minHeight="48dp" />

        <!-- Language spinner contains the fixed offline choices fr, en, and ar. -->
        <Spinner
            android:id="@+id/spLang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp" />

        <!-- Dark-theme switch stores a non-sensitive UI preference. -->
        <Switch
            android:id="@+id/swDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="Dark theme" />

        <!-- Token input uses password mode so the secret is not shown in clear text. -->
        <EditText
            android:id="@+id/etToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Token"
            android:inputType="textPassword"
            android:minHeight="48dp" />

        <!-- Button saves clear preferences and encrypted token data. -->
        <Button
            android:id="@+id/btnSavePrefs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Save Prefs" />

        <!-- Button loads preferences while displaying only token length. -->
        <Button
            android:id="@+id/btnLoadPrefs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Load Prefs" />

        <!-- Button writes sample students JSON and a private note file. -->
        <Button
            android:id="@+id/btnSaveJson"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save JSON" />

        <!-- Button reads sample students JSON and private note data. -->
        <Button
            android:id="@+id/btnLoadJson"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Load JSON" />

        <!-- Button exports only non-sensitive content to app-specific external storage. -->
        <Button
            android:id="@+id/btnExternalExport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="External Export" />

        <!-- Button reads the app-specific external export file. -->
        <Button
            android:id="@+id/btnExternalRead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="External Read" />

        <!-- Button clears preferences, files, external export, and cache content. -->
        <Button
            android:id="@+id/btnClear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear All" />

        <!-- Result text reports only non-sensitive status and token length. -->
        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ready"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>
